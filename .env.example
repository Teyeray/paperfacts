# PaperFacts secrets. Copy this file to .env and fill it in; .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Everything that is NOT a secret -- the model, the endpoint, the server port, the fields to extract --
# lives in config.json instead.

# The extraction model's API key. Any OpenAI-compatible endpoint works; which endpoint and which model is
# set by llm.base_url and llm.model in config.json.
PAPERFACTS_LLM_API_KEY=

# Read as a fallback, so an existing DeepSeek setup keeps working without renaming anything.
# DEEPSEEK_API_KEY=

# Optional: point at a key kept outside the repository (a password manager export, a mounted secret).
# PAPERFACTS_LLM_API_KEY_FILE=/run/secrets/paperfacts_llm_key

# Optional deployment overrides. These win over config.json; use them to point one machine at its parser
# services without editing the shared file.
# PAPERFACTS_MINERU_URL=http://localhost:8002
# PAPERFACTS_PADDLE_URL=http://localhost:8080
# PAPERFACTS_DATA_ROOT=data
