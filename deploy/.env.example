# PaperFacts deployment environment variable template
#
# Usage:
#   cd deploy && cp .env.example .env
# docker compose automatically reads the .env file in the **current working directory**, so
# compose commands must be run from inside deploy/
# (or use `docker compose --env-file deploy/.env -f deploy/compose.yaml ...`).
#
# Note: the repo root .gitignore has `.env.*`, which also ignores this file.
# To keep this template in version control, add a negation rule `!deploy/.env.example`
# to .gitignore.


# =============================================================================
# 1) PaddleOCR-VL official image tags (match the official compose file; rarely need changing)
# =============================================================================

# Pipeline / API layer image tag.
# The `-offline` suffix means model weights are baked into the image and the container won't
# fetch them over the network at startup — required on air-gapped machines.
API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline

# VLM inference backend. One of vllm / sglang / fastdeploy.
# This value affects three places at once: the VLM service's image name, genai_server's
# --backend flag, and the pipeline_config_${VLM_BACKEND}.yaml filename loaded by the API layer.
# Confirm all three exist before changing it.
VLM_BACKEND=vllm

# VLM service image tag, also using the offline variant.
VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline


# =============================================================================
# 2) MinerU image build args (optional)
# =============================================================================

# Empty = install torch from PyPI directly (bundles its own CUDA runtime; the host only needs
# the NVIDIA driver). Only set this when the host driver is too old for the default torch build
# and you need an older CUDA wheel index, e.g.:
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
# After changing this, rebuild with `docker compose build --no-cache mineru-router`.
TORCH_INDEX_URL=


# =============================================================================
# 3) The visual validation model on GPU 7 (qwen-vlm-server; optional)
# =============================================================================

# vLLM's official image tag. Qwen3-VL needs a build that knows the architecture; anything from
# v0.11 on does. Pin a tag rather than `latest` so a redeploy is reproducible.
VLLM_IMAGE_TAG=v0.11.0

# The Hugging Face repository vLLM serves, which is also the `model` the orchestrator sends and
# therefore part of validation_key. The 8B fits an 80 GB card with room to spare; the 32B
# (Qwen/Qwen3-VL-32B-Instruct) fits in bf16 with a smaller KV cache and matches the hosted
# default in config.json exactly, so its verdicts are comparable with the pilot's.
VALIDATION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Where the weights come from on first start. Leave as is unless Hugging Face is slow here.
HF_ENDPOINT=https://huggingface.co
HUGGING_FACE_HUB_TOKEN=


# =============================================================================
# 4) Address the orchestrator (the paperfacts main package) uses to reach the parser services
# =============================================================================
#
# These two variables are **not** used by compose — they're read by the shell that runs the
# `paperfacts` CLI. The main package's src/paperfacts/config.py reads environment variables
# with the PAPERFACTS_ prefix:
#   both URLs empty  → run parsers as subprocesses via the PEP 723 scripts under runners/
#                       (dev machine mode)
#   both URLs set    → call the long-running services deployed here over HTTP
#                       (production mode)
#
# If the orchestrator runs on the same machine as this compose stack, localhost is fine; on a
# different machine, use this server's IP/hostname instead (and make sure the firewall allows
# 8002 / 8080).
PAPERFACTS_MINERU_URL=http://localhost:8002
PAPERFACTS_PADDLE_URL=http://localhost:8080

# To read pages back with the server's own model instead of the hosted Qwen3-VL from config.json,
# export these two as well (the model name must equal VALIDATION_MODEL above).
#PAPERFACTS_VLM_BASE_URL=http://localhost:8090/v1
#PAPERFACTS_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
